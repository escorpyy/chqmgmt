datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum UserRole {
  ADMIN   // full access, including user management and permanent-delete from Trash
  STAFF   // day-to-day cheque/party/bank data entry, no user management
}

// A single business/ecosystem. Every operational record (parties, banks,
// staff, accounts, fiscal years, cheques) belongs to exactly one Company —
// switching companies in the header changes which slice of the data you see.
model Company {
  id          String @id @default(cuid())
  name        String

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Additional users granted access by an admin, beyond the creator/owner.
  // See CompanyMember below — this is what lets a STAFF account actually
  // see any data at all, since access used to be creator-only.
  members     CompanyMember[]

  parties             Party[]
  banks               Bank[]
  staff               Staff[]
  companyBankAccounts CompanyBankAccount[]
  fiscalYears         FiscalYear[]
  cheques             Cheque[]
  issuedCheques       IssuedCheque[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

// Grants a user (typically STAFF) access to a company they didn't create.
// Pure access-control record, not financial data, so unlike the models
// above this cascades: deleting the company or the user should just drop
// the grant, not be blocked by it.
model CompanyMember {
  id        String   @id @default(cuid())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

enum ChequeStatus {
  PENDING     // received, not yet followed up
  DEPOSITED   // handed in / dropped at the bank, not yet submitted for clearing
  FOLLOWUP    // in the call/negotiation cycle
  ON_CHECK    // true status unknown — wasn't updated in time, needs manual re-verification
  PRESENTED   // submitted to bank
  CLEARED     // fully recovered (via bank presentment OR partial payments)
  RETURNED    // bounced/dishonored
  CANCELLED   // receivable written off/voided without going through RETURNED
}

enum ClearanceMethod {
  PRESENTMENT       // cleared normally through the bank
  PARTIAL_RECOVERY  // cleared by accumulating partial payments after default
}

enum FollowUpResponse {
  CONFIRMED                 // "go ahead, present it"
  REQUESTED_DELAY           // "please hold, not yet"
  REQUESTED_REPLACEMENT     // "I'll issue a new cheque"
  REQUESTED_PARTIAL_PAYMENT // "I'll pay part of it now, in cash/IPS/etc."
  REQUESTED_RETURN          // "already paid, return my cheque"
  UNREACHABLE               // no answer / could not reach
  OTHER
}

enum ReturnReason {
  INSUFFICIENT_FUNDS
  SIGNATURE_MISMATCH
  ACCOUNT_CLOSED
  STOPPED_BY_ISSUER
  DATE_ISSUE           // stale/post-dated/expired
  OTHER
}

enum PaymentMethod {
  CASH
  IPS
  CIPS
  QR
  BANK_DEPOSIT
  OTHER
}

enum IssuedChequeStatus {
  ISSUED      // handed to payee (or transfer initiated) — outcome not yet known
  ON_CHECK    // true status unknown — set aside, excluded from balance deduction, needs manual re-verification
  CLEARED     // fully settled (via presentment OR partial payments)
  RETURNED    // bounced/dishonored — may be followed up (see IssuedChequeFollowUp) and/or replaced
  STOPPED     // payment stopped/cancelled by us before clearing
}

enum IssuedFollowUpResponse {
  WILL_REPRESENT            // payee agrees to redeposit the same cheque
  REQUESTED_REPLACEMENT     // we'll issue a new cheque instead
  REQUESTED_PARTIAL_PAYMENT // we'll settle partially via cash/transfer
  DISPUTE                   // payee disputes the amount/cheque
  UNREACHABLE
  OTHER
}

enum PartyType {
  FIRM
  INDIVIDUAL
}

enum ChequeType {
  ACCOUNT_PAYEE   // payee is a firm — crossed cheque, must clear through the payee's bank account
  BEARER          // payee is an individual — can be cashed directly
}

// Which of the three real-world reasons this payment went out — separate
// from payeeType (firm/individual), since e.g. a cash withdrawal has no
// meaningful firm/individual distinction at all.
enum PayeeCategory {
  SUPPLIER
  STAFF
  CASH
  OTHER
}

model FiscalYear {
  id        String   @id @default(cuid())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  year      String   // e.g. "2083/84" — unique per company, see @@unique below
  cheques   Cheque[]
  issuedCheques IssuedCheque[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year])
  @@index([companyId])
}

model Party {
  id        String     @id @default(cuid())

  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  type      PartyType
  name      String
  phone     String?
  address   String?
  panNo     String?    // unique per company, see @@unique below

  // A party's role(s) in the business relationship — independent of `type`
  // (which is about legal structure: firm vs individual). Deliberately two
  // booleans rather than a single enum with a CUSTOMER/VENDOR/BOTH value:
  // a party that's both just has both set true, and each screen filters on
  // its own flag rather than needing to special-case a third state. At
  // least one must be true — enforced in the API and via a DB check
  // constraint (see manual-migration-additions.sql #8).
  isCustomer Boolean   @default(true)  // appears in the received-cheque issuer picker
  isVendor   Boolean   @default(false) // appears in the issued-cheque payee picker

  // For an INDIVIDUAL party: the firm they're affiliated with/represent
  firmId    String?
  firm      Party?     @relation("PartyFirm", fields: [firmId], references: [id], onDelete: Restrict)
  members   Party[]    @relation("PartyFirm") // if type = FIRM: individuals affiliated with this firm

  cheques     Cheque[]
  paidCheques IssuedCheque[] @relation("PayeeParty")

  deletedAt DateTime?  // soft delete — never hard-delete a party with financial history
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([companyId, panNo])
  @@index([companyId])
  @@index([name])
  @@index([firmId])
  @@index([deletedAt])
  @@index([isCustomer])
  @@index([isVendor])
}

model Bank {
  id               String   @id @default(cuid())

  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name             String   // unique per company (case-sensitive at the Prisma/Postgres level — see manual-migration-additions.sql for a case-insensitive unique index), see @@unique below
  branch           String?
  draweeCheques    Cheque[] @relation("DraweeBank")
  presentedCheques Cheque[] @relation("PresentedBank")
  companyAccounts  CompanyBankAccount[]
  deletedAt        DateTime? // soft delete — a bank used on old cheques must never be hard-deleted
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Staff {
  id        String           @id @default(cuid())

  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name      String
  phone     String?
  cheques   Cheque[]         @relation("HandledBy")
  followUps ChequeFollowUp[] @relation("FollowedUpBy")
  payments  ChequePayment[]  @relation("PaymentRecordedBy")

  issuedCheques   IssuedCheque[]         @relation("IssuedBy")
  authorizedCheques IssuedCheque[]       @relation("AuthorizedBy")
  issuedFollowUps IssuedChequeFollowUp[] @relation("IssuedFollowedUpBy")
  issuedPayments  IssuedChequePayment[]  @relation("IssuedPaymentRecordedBy")

  checkLogs       ChequeCheckLog[]       @relation("RaisedBy")
  issuedCheckLogs IssuedChequeCheckLog[] @relation("IssuedRaisedBy")

  deletedAt DateTime?        // soft delete — a staff member with cheque history must never be hard-deleted
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([companyId])
}

model CompanyBankAccount {
  id            String   @id @default(cuid())

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  bankId        String
  bank          Bank     @relation(fields: [bankId], references: [id], onDelete: Restrict)
  accountName   String   // legal name on the account, e.g. "B Enterprises Pvt. Ltd."
  accountNumber String   // unique per company, see @@unique below
  branch        String?
  issuedCheques IssuedCheque[] @relation("SourceAccount")
  transfersIn   IssuedCheque[] @relation("TransferDestination")
  dailyBalances DailyBankBalance[]
  deletedAt     DateTime? // soft delete — an account used on old issued cheques must never be hard-deleted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, accountNumber])
  @@index([companyId])
  @@index([bankId])
}

// One row per company bank account per calendar day. openingBalance and
// receivedToday are both entered by hand each morning — receivedToday is a
// manual running total for now (e.g. cash/other deposits), not pulled from
// cleared received cheques. "Cheques due" (how much of that balance is
// already spoken for) is NOT stored here — it's computed on read from
// IssuedCheque, since it changes as cheques get cancelled/cleared/etc.
model DailyBankBalance {
  id                    String             @id @default(cuid())

  companyBankAccountId  String
  companyBankAccount    CompanyBankAccount @relation(fields: [companyBankAccountId], references: [id], onDelete: Restrict)

  date                  DateTime           @db.Date
  openingBalance        Decimal            @db.Decimal(14, 2)
  receivedToday         Decimal            @default(0) @db.Decimal(14, 2)

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([companyBankAccountId, date])
  @@index([date])
}

model Cheque {
  id          String            @id @default(cuid())

  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  fiscalYearId String           // FY this cheque is booked under, e.g. "2083/84"
  fiscalYear   FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  receiptNo    String?          // Rpt No, e.g. "UR-001" — free text; not unique, ChqNo is the real unique key

  refNo       String?           // Ref No, e.g. "URT-001/01" — manually transcribed from a physical reference book, no fixed format

  issuerId    String
  issuer      Party             @relation(fields: [issuerId], references: [id], onDelete: Restrict)

  issuedOn         String        // payee name actually written on the cheque
  issuedOnType     PartyType     // is issuedOn a firm or an individual?
  chequeType       ChequeType    // derived from issuedOnType: FIRM -> ACCOUNT_PAYEE, INDIVIDUAL -> BEARER
  payableToCompany Boolean       @default(true) // only meaningful when issuedOnType = FIRM: does that firm match your own company?

  chqDate     DateTime          // date on the cheque / presenting date
  chqNo       String            // unique per bank, see @@unique([bankId, chqNo]) below

  // Drawee bank: the bank the cheque is drawn on (issuer's bank)
  bankId      String
  bank        Bank              @relation("DraweeBank", fields: [bankId], references: [id], onDelete: Restrict)

  // Presenting bank: where WE deposited/presented it for collection (can differ from drawee bank)
  presentedBankId String?
  presentedBank   Bank?         @relation("PresentedBank", fields: [presentedBankId], references: [id], onDelete: Restrict)

  // Issuer's account number as written on the cheque itself. Free text —
  // not validated/unique, just transcribed for the register.
  accountNo   String?

  amount      Decimal           @db.Decimal(14, 2)

  status      ChequeStatus      @default(PENDING)
  statusDate  DateTime          @default(now())

  // When status becomes ON_CHECK, this captures what it was right before —
  // so whoever picks up the investigation has a starting point, without
  // pretending we still know for certain it's accurate.
  previousStatus   ChequeStatus?
  checkLogs        ChequeCheckLog[]

  // Stored lifecycle duration: statusDate - chqDate, in days.
  // Only meaningful once statusDate >= chqDate; null otherwise.
  // NOTE: not auto-maintained by Prisma — must be recalculated whenever
  // status/statusDate changes (in app code, or via a Postgres generated
  // column set up in a custom migration).
  totalDays   Int?

  // Per-stage timestamps. Unlike statusDate (which only ever reflects the
  // *current* status), these are stamped once when the cheque first enters
  // that stage and then left alone — so "when was this deposited" stays
  // answerable even after the cheque has since cleared or bounced.
  // Set by app code in lib/chequeHelpers.js (receivedStageTimestampFields)
  // everywhere the status can change.
  depositedAt DateTime?
  presentedAt DateTime?
  clearedAt   DateTime?
  bouncedAt   DateTime?  // stamped when status becomes RETURNED
  cancelledAt DateTime?

  clearanceMethod ClearanceMethod?  // set when status becomes CLEARED

  // Return handling
  returnReason ReturnReason?
  returnNote   String?

  // Replacement chain: a returned cheque can be replaced by a new one
  replacesChequeId String?  @unique
  replaces         Cheque?  @relation("ChequeReplacement", fields: [replacesChequeId], references: [id], onDelete: Restrict)
  replacedBy       Cheque?  @relation("ChequeReplacement")

  staffId     String?
  staff       Staff?            @relation("HandledBy", fields: [staffId], references: [id], onDelete: Restrict)

  followUps   ChequeFollowUp[]
  payments    ChequePayment[]

  deletedAt   DateTime?         // soft delete — financial records are never hard-deleted
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([bankId, chqNo])
  @@index([companyId])
  @@index([status, chqDate])
  @@index([chqDate])
  @@index([fiscalYearId])
  @@index([issuerId])
  @@index([presentedBankId])
  @@index([staffId])
  @@index([deletedAt])
}

model ChequeFollowUp {
  id             String            @id @default(cuid())
  chequeId       String
  cheque         Cheque            @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  followUpDate   DateTime          @default(now())
  response       FollowUpResponse
  note           String?
  nextActionDate DateTime?

  staffId        String?
  staff          Staff?            @relation("FollowedUpBy", fields: [staffId], references: [id], onDelete: Restrict)

  createdAt      DateTime          @default(now())

  @@index([chequeId])
  @@index([staffId])
}

model ChequePayment {
  id            String        @id @default(cuid())
  chequeId      String
  cheque        Cheque        @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  referenceNo   String?       // transaction/txn ref for IPS, CIPS, QR
  paymentDate   DateTime      @default(now())
  note          String?

  staffId       String?
  staff         Staff?        @relation("PaymentRecordedBy", fields: [staffId], references: [id], onDelete: Restrict)

  createdAt     DateTime      @default(now())

  @@index([chequeId])
  @@index([staffId])
}

model IssuedCheque {
  id          String              @id @default(cuid())

  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  companyBankAccountId String
  companyBankAccount   CompanyBankAccount @relation("SourceAccount", fields: [companyBankAccountId], references: [id], onDelete: Restrict)

  fiscalYearId String             // FY this payment is booked under, e.g. "2083/84" — mirrors Cheque.fiscalYearId
  fiscalYear   FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  pvNo         String?            // Payment Voucher No. — free text, mirrors Cheque.receiptNo

  chqNo       String              // unique per our own account, see @@unique below
  chqDate     DateTime

  // Exactly one of (payeeId/payeeName) or transferToAccountId is set — a
  // cheque either pays an external party, or moves money between two of
  // our own accounts, never both and never neither. Enforced both in
  // application validation (routes/issuedCheques.js) and by a DB check
  // constraint added via raw SQL below (Prisma has no CHECK syntax), so it
  // can't drift even from a direct DB write.
  payeeId       String?
  payee         Party?              @relation("PayeeParty", fields: [payeeId], references: [id], onDelete: Restrict)
  payeeName     String?             // name actually written on the cheque (may differ from payee.name) — null for a transfer
  payeeType     PartyType?          // is payeeName a firm or an individual? — null for a transfer
  payeeCategory PayeeCategory?      // SUPPLIER / STAFF / CASH / OTHER — null for a transfer

  transferToAccountId String?
  transferToAccount   CompanyBankAccount? @relation("TransferDestination", fields: [transferToAccountId], references: [id], onDelete: Restrict)

  // Firm -> crossed/account-payee; individual -> bearer. A transfer to our
  // own account is always account-payee (never bearer, since it's never
  // meant to be cashed) — see the derivation in routes/issuedCheques.js.
  chequeType  ChequeType

  // Senior person who approved/directed this payment — distinct from
  // issuedById below (who physically wrote/handed it over).
  authorityId String?
  authority   Staff?              @relation("AuthorizedBy", fields: [authorityId], references: [id], onDelete: Restrict)

  amount      Decimal             @db.Decimal(14, 2)
  purpose     String?             // free-text note on what this payment is for (can reference a bill/invoice no.)

  status      IssuedChequeStatus  @default(ISSUED)
  statusDate  DateTime            @default(now())
  totalDays   Int?                // stored; same recalculation caveat as Cheque.totalDays

  // Same reconciliation pattern as the received-cheque side: when status
  // becomes ON_CHECK (e.g. cheque book stub vs bank statement mismatch),
  // this preserves what it was before, without pretending we're still sure.
  previousStatus IssuedChequeStatus?
  checkLogs      IssuedChequeCheckLog[]

  // Per-stage timestamps — same rationale as Cheque's: statusDate only ever
  // reflects the *current* status, these persist per stage regardless of
  // where the cheque ends up later. There's no depositedAt/presentedAt on
  // this side — we only ever learn the final outcome (cleared or
  // bounced/returned), never when the payee actually presented it.
  clearedAt   DateTime?
  bouncedAt   DateTime?  // stamped when status becomes RETURNED
  cancelledAt DateTime?  // stamped when status becomes STOPPED

  clearanceMethod ClearanceMethod?
  returnReason    ReturnReason?
  returnNote      String?

  // Replacement chain, same pattern as the received-cheque side
  replacesChequeId String?        @unique
  replaces         IssuedCheque?  @relation("IssuedChequeReplacement", fields: [replacesChequeId], references: [id], onDelete: Restrict)
  replacedBy       IssuedCheque?  @relation("IssuedChequeReplacement")

  issuedById  String?
  issuedBy    Staff?              @relation("IssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  followUps   IssuedChequeFollowUp[]
  payments    IssuedChequePayment[]

  deletedAt   DateTime?           // soft delete — financial records are never hard-deleted
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([companyBankAccountId, chqNo])
  @@index([companyId])
  @@index([status, chqDate])
  @@index([chqDate])
  @@index([fiscalYearId])
  @@index([payeeId])
  @@index([issuedById])
  @@index([authorityId])
  @@index([transferToAccountId])
  @@index([deletedAt])
}

model IssuedChequeFollowUp {
  id             String                  @id @default(cuid())
  issuedChequeId String
  issuedCheque   IssuedCheque            @relation(fields: [issuedChequeId], references: [id], onDelete: Restrict)

  followUpDate   DateTime                @default(now())
  response       IssuedFollowUpResponse
  note           String?
  nextActionDate DateTime?

  staffId        String?
  staff          Staff?                  @relation("IssuedFollowedUpBy", fields: [staffId], references: [id], onDelete: Restrict)

  createdAt      DateTime                @default(now())

  @@index([issuedChequeId])
  @@index([staffId])
}

model IssuedChequePayment {
  id             String        @id @default(cuid())
  issuedChequeId String
  issuedCheque   IssuedCheque  @relation(fields: [issuedChequeId], references: [id], onDelete: Restrict)

  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  referenceNo    String?
  paymentDate    DateTime      @default(now())
  note           String?

  staffId        String?
  staff          Staff?        @relation("IssuedPaymentRecordedBy", fields: [staffId], references: [id], onDelete: Restrict)

  createdAt      DateTime      @default(now())

  @@index([issuedChequeId])
  @@index([staffId])
}

model ChequeCheckLog {
  id        String   @id @default(cuid())
  chequeId  String
  cheque    Cheque   @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  raisedById   String?
  raisedBy     Staff?  @relation("RaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  reason       String  // why this went to ON_CHECK, e.g. "not updated since last month"
  raisedAt     DateTime @default(now())

  resolvedAt     DateTime?     // null while still under investigation
  resolvedStatus ChequeStatus? // what it turned out to actually be, once verified
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chequeId])
  @@index([raisedById])
}

model IssuedChequeCheckLog {
  id             String       @id @default(cuid())
  issuedChequeId String
  issuedCheque   IssuedCheque @relation(fields: [issuedChequeId], references: [id], onDelete: Restrict)

  raisedById   String?
  raisedBy     Staff?  @relation("IssuedRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  reason       String  // e.g. "cheque stub vs bank statement mismatch during reconciliation"
  raisedAt     DateTime @default(now())

  resolvedAt     DateTime?           // null while still under investigation
  resolvedStatus IssuedChequeStatus? // what it turned out to actually be, once verified
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issuedChequeId])
  @@index([raisedById])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Login brute-force protection: count resets to 0 on any successful
  // login; hitting the threshold sets lockedUntil instead of growing
  // forever, so the count itself never needs to be read past that point.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Forces the password-change modal on next login — set true for the
  // auto-provisioned admin account's random initial password, and
  // reusable later for any admin-triggered password reset.
  mustChangePassword Boolean @default(false)

  companies    Company[]        // companies this user created/owns
  companyMemberships CompanyMember[] // companies this user was granted access to, without owning them

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// express-session store (connect-pg-simple). Table name/shape is fixed by
// that package, not by us — Prisma just needs to know it exists so
// `prisma migrate dev` doesn't try to drop it on a future migration.
model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}